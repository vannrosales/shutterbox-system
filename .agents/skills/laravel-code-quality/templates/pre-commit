#!/usr/bin/env bash
#
# Pre-commit hook.
#
#   cp .claude/skills/laravel-code-quality/templates/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or manage it with the whole team via a package:
#   composer require --dev brainmaestro/composer-git-hooks
#
# KEEP THIS UNDER ~10 SECONDS. A slow hook gets bypassed with --no-verify,
# and a bypassed hook is no hook. Full runs belong in CI.

set -e

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

fail() { printf "${RED}✗ %s${NC}\n" "$1"; exit 1; }
ok()   { printf "${GREEN}✓ %s${NC}\n" "$1"; }
warn() { printf "${YELLOW}! %s${NC}\n" "$1"; }

STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$' || true)

if [ -z "$STAGED_PHP" ]; then
    exit 0
fi

# ── 1. Refuse to commit secrets ─────────────────────────────────────────────
# A committed secret is a breach, not a lint error — rotate it, do not just
# remove the commit.

if git diff --cached --name-only | grep -qE '^\.env$'; then
    fail ".env is staged. Never commit it."
fi

if git diff --cached -U0 | grep -E '^\+' \
   | grep -qE '(sk_live_|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY|password\s*=\s*["\x27][^"\x27]{8,})'; then
    fail "Possible secret in staged changes. Review before committing."
fi

# ── 2. Syntax ───────────────────────────────────────────────────────────────
# Cheapest possible check; catches a typo before the slower tools run.

for file in $STAGED_PHP; do
    php -l "$file" > /dev/null 2>&1 || fail "Syntax error in $file"
done
ok "Syntax"

# ── 3. Debug statements ─────────────────────────────────────────────────────

if git diff --cached -U0 -- $STAGED_PHP | grep -E '^\+' \
   | grep -qE '\b(dd|dump|ray|var_dump|print_r|die|exit)\s*\('; then
    warn "Debug statement in staged changes"
    git diff --cached -U0 -- $STAGED_PHP | grep -nE '^\+.*\b(dd|dump|ray|var_dump)\s*\('
    fail "Remove debug statements, or commit with --no-verify if intentional"
fi
ok "No debug statements"

# ── 4. Code style ───────────────────────────────────────────────────────────

if [ -f vendor/bin/pint ]; then
    vendor/bin/pint --test $STAGED_PHP > /dev/null 2>&1 \
        || fail "Style violations. Run: composer fix"
    ok "Pint"
fi

# ── 5. Static analysis ──────────────────────────────────────────────────────
# Scoped to staged files so it stays fast. CI runs the whole project.

if [ -f vendor/bin/phpstan ]; then
    vendor/bin/phpstan analyse $STAGED_PHP \
        --no-progress --memory-limit=1G --error-format=table \
        || fail "PHPStan errors"
    ok "PHPStan"
fi

# ── 6. Tests for changed files ──────────────────────────────────────────────
# --dirty runs only the tests related to what changed (git-aware).

if [ -f vendor/bin/pest ]; then
    php artisan test --dirty --parallel --quiet \
        || fail "Tests failing"
    ok "Tests"
fi

printf "${GREEN}All checks passed${NC}\n"

# ─────────────────────────────────────────────────────────────────────────────
#  Deliberately NOT here — too slow for a pre-commit hook:
#
#    - Full test suite            → CI
#    - Rector                     → on demand, needs the diff reviewed
#    - Whole-project PHPStan      → CI
#    - Browser / accessibility    → nightly CI
#    - composer audit             → CI (advisories land continuously anyway)
#
#  If the hook creeps past ~10 seconds, move something to CI. The hook exists
#  to catch the mistakes that are embarrassing in a PR, not to replace CI.
# ─────────────────────────────────────────────────────────────────────────────
