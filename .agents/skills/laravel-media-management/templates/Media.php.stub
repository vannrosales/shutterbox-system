<?php

declare(strict_types=1);

/*
 * ─── Migration ──────────────────────────────────────────────────────────────
 *
 * Schema::create('media', function (Blueprint $table): void {
 *     $table->id();
 *     $table->ulid('ulid')->unique();
 *
 *     // NULLABLE so two-step uploads (upload, then attach) are representable —
 *     // and so orphans are findable.
 *     $table->nullableMorphs('attachable');
 *     $table->string('collection', 64)->default('default');
 *
 *     $table->foreignId('uploaded_by')->nullable()->constrained('users')->nullOnDelete();
 *     $table->foreignId('tenant_id')->nullable()->constrained()->cascadeOnDelete();
 *
 *     $table->string('disk', 32);
 *     $table->string('path', 512);
 *     $table->string('original_name', 255);      // display only, never a path
 *     $table->string('mime_type', 128);          // SNIFFED, not client-claimed
 *     $table->unsignedBigInteger('size_bytes');
 *     $table->string('checksum', 64)->index();   // dedup + integrity audit
 *
 *     $table->string('alt', 255)->nullable();    // REQUIRED at validation for images
 *     $table->unsignedInteger('width')->nullable();
 *     $table->unsignedInteger('height')->nullable();
 *     $table->json('derivatives')->nullable();
 *     $table->text('placeholder')->nullable();   // tiny base64 blur
 *
 *     $table->timestamp('processed_at')->nullable();
 *     $table->timestamp('failed_at')->nullable();
 *     $table->timestamps();
 *
 *     $table->index(['attachable_type', 'attachable_id', 'collection']);
 *     $table->index(['tenant_id', 'created_at']);
 *     $table->index(['attachable_id', 'created_at']);   // orphan sweep
 * });
 * ─────────────────────────────────────────────────────────────────────────────
 */

namespace App\Models;

use Illuminate\Database\Eloquent\Builder;
use Illuminate\Database\Eloquent\Factories\HasFactory;
use Illuminate\Database\Eloquent\Model;
use Illuminate\Database\Eloquent\Prunable;
use Illuminate\Database\Eloquent\Relations\MorphTo;
use Illuminate\Support\Facades\Storage;

final class Media extends Model
{
    use HasFactory;

    // Prunable, NOT MassPrunable — pruning() must run per row to delete the files.
    use Prunable;

    /** Derivative widths. Match these to the `sizes` you actually render. */
    public const SIZES = [
        'thumb'  => 200,
        'small'  => 480,
        'medium' => 960,
        'large'  => 1920,
    ];

    public const FORMATS = ['avif', 'webp'];

    protected $fillable = [
        'ulid', 'collection', 'uploaded_by', 'tenant_id',
        'disk', 'path', 'original_name', 'mime_type', 'size_bytes', 'checksum',
        'alt', 'width', 'height', 'derivatives', 'placeholder',
        'processed_at', 'failed_at',
    ];

    protected function casts(): array
    {
        return [
            'derivatives'  => 'array',
            'size_bytes'   => 'integer',
            'width'        => 'integer',
            'height'       => 'integer',
            'processed_at' => 'immutable_datetime',
            'failed_at'    => 'immutable_datetime',
        ];
    }

    public function attachable(): MorphTo
    {
        return $this->morphTo();
    }

    // ── Paths ───────────────────────────────────────────────────────────────

    /**
     * One directory per media item, sharded by date and ULID prefix.
     * Date prefix → retention by directory. ULID prefix → bounded fan-out.
     */
    public function directory(): string
    {
        return sprintf(
            'media/%s/%s/%s',
            $this->created_at->format('Y/m'),
            substr($this->ulid, 0, 2),
            $this->ulid,
        );
    }

    public function derivativePath(string $size, string $format): string
    {
        return "{$this->directory()}/{$size}.{$format}";
    }

    // ── URLs ────────────────────────────────────────────────────────────────

    public function url(string $size = 'medium', ?string $format = null): string
    {
        $format ??= $this->isImage() ? 'webp' : null;

        $path = $format !== null && $this->processed_at !== null
            ? $this->derivativePath($size, $format)
            : $this->path;

        // Private files must never get a plain URL.
        return $this->disk === 'private'
            ? route('media.show', ['media' => $this->ulid, 'size' => $size])
            : Storage::disk($this->disk)->url($path);
    }

    public function temporaryUrl(int $minutes = 15): string
    {
        return Storage::disk($this->disk)->temporaryUrl($this->path, now()->addMinutes($minutes));
    }

    /**
     * Builds the srcset for one format, largest last.
     * Only includes sizes that were actually generated (never upscaled).
     */
    public function srcset(string $format = 'webp'): string
    {
        return collect($this->derivatives[$format] ?? [])
            ->map(fn (int $width, string $size): string => $this->url($size, $format)." {$width}w")
            ->implode(', ');
    }

    // ── Predicates ──────────────────────────────────────────────────────────

    public function isImage(): bool
    {
        return str_starts_with($this->mime_type, 'image/');
    }

    public function isProcessed(): bool
    {
        return $this->processed_at !== null;
    }

    public function hasFailed(): bool
    {
        return $this->failed_at !== null;
    }

    public function humanSize(): string
    {
        return \Illuminate\Support\Number::fileSize($this->size_bytes, precision: 1);
    }

    // ── Scopes ──────────────────────────────────────────────────────────────

    public function scopeOrphaned(Builder $query, int $olderThanHours = 24): void
    {
        $query->whereNull('attachable_id')
            ->where('created_at', '<', now()->subHours($olderThanHours));
    }

    public function scopeUnprocessed(Builder $query): void
    {
        $query->whereNull('processed_at')->whereNull('failed_at');
    }

    // ── Lifecycle ───────────────────────────────────────────────────────────

    /** Two-step uploads leave rows with no owner. Sweep them daily. */
    public function prunable(): Builder
    {
        return static::query()->orphaned();
    }

    protected function pruning(): void
    {
        $this->deleteFiles();
    }

    protected static function booted(): void
    {
        static::deleted(function (Media $media): void {
            $media->deleteFiles();
        });
    }

    /**
     * Deletes the whole item directory — original and every derivative in one call,
     * so a derivative can never be orphaned.
     *
     * If you deduplicate by checksum across rows, reference-count first (see
     * references/lifecycle.md) or one row's deletion breaks another's file.
     */
    private function deleteFiles(): void
    {
        Storage::disk($this->disk)->deleteDirectory($this->directory());
    }
}

/* ─────────────────────────────────────────────────────────────────────────────
   Trait for anything that owns media

   trait HasMedia
   {
       public function media(): MorphMany
       {
           return $this->morphMany(Media::class, 'attachable');
       }

       public function mediaIn(string $collection): MorphMany
       {
           return $this->media()->where('collection', $collection);
       }

       public function firstMedia(string $collection = 'default'): ?Media
       {
           return $this->relationLoaded('media')
               ? $this->media->firstWhere('collection', $collection)
               : $this->mediaIn($collection)->first();
       }
   }

   Note firstMedia(): reading from the loaded relation when available avoids an
   N+1 in list views. Eager load with ->with('media') — see laravel-performance.

   ─────────────────────────────────────────────────────────────────────────────
   Schedule::command('model:prune')->daily()->at('03:00');
   Schedule::command('media:audit')->monthly();       // report only, never --fix
   ───────────────────────────────────────────────────────────────────────────── */
