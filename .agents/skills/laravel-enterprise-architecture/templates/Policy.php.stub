<?php

declare(strict_types=1);

namespace App\Policies;

use App\Models\{{ Model }};
use App\Models\User;
use Illuminate\Auth\Access\Response;

final class {{ Model }}Policy
{
    /**
     * Runs before every other method. Use sparingly — a broad admin bypass here
     * silently disables every check below it.
     */
    // public function before(User $user, string $ability): ?bool
    // {
    //     return $user->isSuperAdmin() ? true : null;
    // }

    public function viewAny(User $user): bool
    {
        return $user->hasPermission('{{ model }}.view');
    }

    public function view(User $user, {{ Model }} ${{ model }}): Response
    {
        return $this->sameTenant($user, ${{ model }})
            ? Response::allow()
            : Response::denyAsNotFound();   // do not confirm the record exists
    }

    public function create(User $user): bool
    {
        return $user->hasPermission('{{ model }}.create');
    }

    public function update(User $user, {{ Model }} ${{ model }}): Response
    {
        if (! $this->sameTenant($user, ${{ model }})) {
            return Response::denyAsNotFound();
        }

        return $user->hasPermission('{{ model }}.update')
            ? Response::allow()
            : Response::deny(__('You do not have permission to edit this record.'));
    }

    public function delete(User $user, {{ Model }} ${{ model }}): Response
    {
        return $this->update($user, ${{ model }});
    }

    private function sameTenant(User $user, {{ Model }} ${{ model }}): bool
    {
        return $user->tenant_id === ${{ model }}->tenant_id;
    }
}
