{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shutterbox System",
  "version": "0.1.0",
  "identifier": "com.shutterbox.system",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:8000",
    "beforeBuildCommand": "node scripts/prepare-tauri.js",
    "frontendDist": "http://localhost:8000"
  },
  "app": {
    "windows": [
      {
        "title": "Shutterbox System",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "url": "http://localhost:8000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "resources": [
      "resources/**/*"
    ],
    "shortDescription": "Shutterbox System Desktop Application",
    "longDescription": "Shutterbox System Desktop Application built with Laravel, Inertia React, and Tauri v2."
  }
}
